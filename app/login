'use client'

import { useState, useEffect } from 'react'
import { useRouter } from 'next/navigation'
import Link from 'next/link'
import { supabase } from '../../lib/supabase'

export default function LoginPage() {
  const router = useRouter()
  const [isRegistering, setIsRegistering] = useState(false)
  const [email, setEmail] = useState('')
  const [password, setPassword] = useState('')
  const [loading, setLoading] = useState(false)
  const [user, setUser] = useState<any>(null)
  const [userRole, setUserRole] = useState<string | null>(null)
  const [message, setMessage] = useState<{ text: string; type: 'error' | 'success' } | null>(null)

  // Pārbaudām, vai lietotājs jau ir ielogojies
  useEffect(() => {
    checkUser()
  }, [])

  const checkUser = async () => {
    const { data: { session } } = await supabase.auth.getSession()
    if (session?.user) {
      setUser(session.user)
      fetchUserRole(session.user.id)
    } else {
      setUser(null)
      setUserRole(null)
    }
  }

  const fetchUserRole = async (userId: string) => {
    const { data, error } = await supabase
      .from('profiles')
      .select('role')
      .eq('id', userId)
      .single()

    if (data && !error) {
      setUserRole(data.role)
    }
  }

  // Ielogošanās un reģistrācijas apstrāde
  const handleSubmit = async (e: React.FormEvent) => {
    e.preventDefault()
    setLoading(true)
    setMessage(null)

    try {
      if (isRegistering) {
        // Reģistrācija
        const { data, error } = await supabase.auth.signUp({
          email,
          password,
        })

        if (error) throw error

        setMessage({
          text: 'Reģistrācija veiksmīga! Lūdzu, pārbaudi savu e-pastu, lai apstiprinātu kontu (vai ielogojies, ja e-pasta apstiprināšana nav ieslēgta).',
          type: 'success'
        })
      } else {
        // Ielogošanās
        const { data, error } = await supabase.auth.signInWithPassword({
          email,
          password,
        })

        if (error) throw error

        setMessage({ text: 'Veiksmīgi ielogojies!', type: 'success' })
        await checkUser()
        setTimeout(() => {
          router.push('/')
          router.refresh()
        }, 1000)
      }
    } catch (err: any) {
      setMessage({ text: err.message || 'Notika kļūda', type: 'error' })
    } finally {
      setLoading(false)
    }
  }

  // Izlogošanās
  const handleLogout = async () => {
    await supabase.auth.signOut()
    setUser(null)
    setUserRole(null)
    setMessage({ text: 'Esat izlogojies no sistēmas.', type: 'success' })
    router.refresh()
  }

  return (
    <div style={{ maxWidth: '450px', margin: '40px auto', padding: '24px', fontFamily: 'sans-serif', border: '1px solid #e5e7eb', borderRadius: '12px', boxShadow: '0 4px 6px -1px rgba(0,0,0,0.1)' }}>
      <Link href="/" style={{ color: '#2563eb', textDecoration: 'none', display: 'inline-block', marginBottom: '16px', fontSize: '14px' }}>
        ← Atpakaļ uz sākumlapu
      </Link>

      {user ? (
        // Ja lietotājs ir ielogojies
        <div style={{ textAlign: 'center' }}>
          <h1 style={{ fontSize: '22px', fontWeight: 'bold', marginBottom: '12px' }}>Tavs profils</h1>
          <p style={{ color: '#4b5563', marginBottom: '8px' }}>
            Ielogojies kā: <strong>{user.email}</strong>
          </p>
          <p style={{ color: '#4b5563', marginBottom: '20px' }}>
            Loma sistēmā: <span style={{ backgroundColor: '#e0e7ff', color: '#3730a3', padding: '2px 8px', borderRadius: '4px', fontWeight: 'bold', textTransform: 'uppercase', fontSize: '12px' }}>{userRole || 'seller'}</span>
          </p>

          <div style={{ display: 'flex', flexDirection: 'column', gap: '10px' }}>
            <Link
              href="/pievienot"
              style={{
                padding: '10px',
                backgroundColor: '#16a34a',
                color: '#fff',
                borderRadius: '6px',
                textDecoration: 'none',
                fontWeight: 'bold'
              }}
            >
              + Pievienot jaunu auto
            </Link>

            <button
              onClick={handleLogout}
              style={{
                padding: '10px',
                backgroundColor: '#ef4444',
                color: '#fff',
                border: 'none',
                borderRadius: '6px',
                cursor: 'pointer',
                fontWeight: 'bold'
              }}
            >
              Izlogoties
            </button>
          </div>
        </div>
      ) : (
        // Ja lietotājs nav ielogojies
        <div>
          <h1 style={{ fontSize: '22px', fontWeight: 'bold', marginBottom: '8px', textAlign: 'center' }}>
            {isRegistering ? 'Reģistrēties' : 'Ielogoties'}
          </h1>
          <p style={{ fontSize: '14px', color: '#6b7280', textAlign: 'center', marginBottom: '20px' }}>
            {isRegistering ? 'Izveido kontu, lai pievienotu un pārvaldītu savus auto' : 'Ienāc savā kontā'}
          </p>

          {message && (
            <div style={{
              padding: '12px',
              borderRadius: '6px',
              marginBottom: '16px',
              fontSize: '14px',
              backgroundColor: message.type === 'error' ? '#fef2f2' : '#f0fdf4',
              color: message.type === 'error' ? '#991b1b' : '#166534',
              border: `1px solid ${message.type === 'error' ? '#fecaca' : '#bbf7d0'}`
            }}>
              {message.text}
            </div>
          )}

          <form onSubmit={handleSubmit} style={{ display: 'flex', flexDirection: 'column', gap: '14px' }}>
            <div>
              <label style={{ display: 'block', marginBottom: '4px', fontSize: '14px', fontWeight: 'bold' }}>E-pasts</label>
              <input
                type="email"
                required
                value={email}
                onChange={(e) => setEmail(e.target.value)}
                placeholder="vards@epasts.lv"
                style={{ width: '100%', padding: '10px', borderRadius: '6px', border: '1px solid #d1d5db', boxSizing: 'border-box' }}
              />
            </div>

            <div>
              <label style={{ display: 'block', marginBottom: '4px', fontSize: '14px', fontWeight: 'bold' }}>Parole</label>
              <input
                type="password"
                required
                minLength={6}
                value={password}
                onChange={(e) => setPassword(e.target.value)}
                placeholder="Vismaz 6 simboli"
                style={{ width: '100%', padding: '10px', borderRadius: '6px', border: '1px solid #d1d5db', boxSizing: 'border-box' }}
              />
            </div>

            <button
              type="submit"
              disabled={loading}
              style={{
                padding: '12px',
                backgroundColor: '#2563eb',
                color: '#fff',
                border: 'none',
                borderRadius: '6px',
                fontWeight: 'bold',
                cursor: loading ? 'wait' : 'pointer',
                marginTop: '6px'
              }}
            >
              {loading ? 'Apstrādā...' : isRegistering ? 'Reģistrēties' : 'Ielogoties'}
            </button>
          </form>

          <div style={{ marginTop: '20px', textAlign: 'center', fontSize: '14px', color: '#4b5563' }}>
            {isRegistering ? (
              <p>
                Jau ir konts?{' '}
                <button
                  type="button"
                  onClick={() => { setIsRegistering(false); setMessage(null); }}
                  style={{ color: '#2563eb', background: 'none', border: 'none', cursor: 'pointer', fontWeight: 'bold', padding: 0 }}
                >
                  Ielogoties
                </button>
              </p>
            ) : (
              <p>
                Nav konta?{' '}
                <button
                  type="button"
                  onClick={() => { setIsRegistering(true); setMessage(null); }}
                  style={{ color: '#2563eb', background: 'none', border: 'none', cursor: 'pointer', fontWeight: 'bold', padding: 0 }}
                >
                  Reģistrēties
                </button>
              </p>
            )}
          </div>
        </div>
      )}
    </div>
  )
}
